# Copy this file to ".env" and fill in your PostgreSQL connection details.
# If you leave POSTGRES_HOST blank/unset, the app falls back to a local
# SQLite file automatically, so you can run it without Postgres installed.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restaurant_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
# Optional, useful for managed/cloud Postgres providers requiring SSL:
POSTGRES_SSLMODE=

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC
